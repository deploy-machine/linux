#!/bin/sh
# tmux configuration and plugins (Tmux Plugin Manager + the @plugin list in
# env/.config/tmux/tmux.conf). The work lives in scripts/tmux-setup.sh, which
# ./dev also runs at the end of every ./run so the state is always repaired.
DEV_ENV_HOME="${DEV_ENV_HOME:-$(cd "$(dirname "$0")/../.." && pwd)}"
export DEV_ENV_HOME
exec "$DEV_ENV_HOME/scripts/tmux-setup.sh" "$@"
