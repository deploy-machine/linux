#!/bin/sh
# OpenBSD 7.9 -- browsers
set -eu

dry_run="0"
if [ "${1:-}" = "--dry" ]; then dry_run="1"; fi

log() {
    if [ "$dry_run" = "1" ]; then echo "[DRY_RUN]: $1"; else echo "$1"; fi
}

do_run() {
    log "+ $*"
    if [ "$dry_run" = "0" ]; then "$@"; fi
}

# not applicable on OpenBSD: Microsoft Edge (.deb only).

# Firefox installs natively, not as a flatpak
do_run doas pkg_add -I firefox
