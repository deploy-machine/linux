#!/bin/sh
# OpenBSD 7.9 -- wallpaper tools and distro wallpaper selection
set -eu

dry_run="0"
if [ "${1:-}" = "--dry" ]; then dry_run="1"; fi

log() {
    if [ "$dry_run" = "1" ]; then echo "[DRY_RUN]: $1"; else echo "$1"; fi
}

do_run() {
    log "+ $*"
    if [ "$dry_run" = "0" ]; then "$@"; fi
}

DEV_ENV_HOME="${DEV_ENV_HOME:-$(cd "$(dirname "$0")/../.." && pwd)}"

# Install wallpaper software, imagemagick and ffmpeg
do_run doas pkg_add -I feh ffmpeg ImageMagick

XPROFILE_FILE="$DEV_ENV_HOME/env/.xprofile"

# OpenBSD has no /etc/os-release; the kernel name is all we need here.
if [ "$(uname -s)" = "OpenBSD" ]; then
    TARGET_WALLPAPER="od_openbsd.png"
else
    echo "ERROR: this script is for OpenBSD only (uname -s: $(uname -s))"
    exit 1
fi

if [ ! -f "$XPROFILE_FILE" ]; then
    echo "ERROR: .xprofile file not found at '$XPROFILE_FILE'"
    exit 1
fi

# Idempotent: nothing to do when already set
if grep -Fq "DISTRO_WALLPAPER=\"${TARGET_WALLPAPER}\"" "$XPROFILE_FILE"; then
    log "Wallpaper in '$XPROFILE_FILE' is already set to '$TARGET_WALLPAPER'. No changes needed."
    exit 0
fi

log "Setting DISTRO_WALLPAPER to '$TARGET_WALLPAPER' in '$XPROFILE_FILE'"
if [ "$dry_run" = "1" ]; then
    exit 0
fi

# Backup like the Linux branches (POSIX date(1) format only)
BACKUP_FILE="${XPROFILE_FILE}.$(date +%Y%m%d_%H%M%S).bak"
cp "$XPROFILE_FILE" "$BACKUP_FILE"

# BSD sed has no GNU-style `sed -i`; edit through a temporary file
TMP_FILE=$(mktemp)
sed "s|^DISTRO_WALLPAPER=.*|DISTRO_WALLPAPER=\"${TARGET_WALLPAPER}\"|" "$XPROFILE_FILE" > "$TMP_FILE"
if grep -Fq "DISTRO_WALLPAPER=\"${TARGET_WALLPAPER}\"" "$TMP_FILE"; then
    mv "$TMP_FILE" "$XPROFILE_FILE"
    log "SUCCESS: Wallpaper in '$XPROFILE_FILE' updated to '$TARGET_WALLPAPER'."
else
    rm -f "$TMP_FILE"
    echo "ERROR: no DISTRO_WALLPAPER= line found in '$XPROFILE_FILE'; backup at '$BACKUP_FILE'."
    exit 1
fi
