#!/bin/sh
# OpenBSD 7.9 -- ascii webcam / terminal media player
# Tolerates failure on purpose in the opt-in cargo block at the end.
set -u

dry_run="0"
if [ "${1:-}" = "--dry" ]; then dry_run="1"; fi

log() {
    if [ "$dry_run" = "1" ]; then echo "[DRY_RUN]: $1"; else echo "$1"; fi
}

do_run() {
    log "+ $*"
    if [ "$dry_run" = "0" ]; then "$@"; fi
}

# The Linux branches build OpenCV and cargo-install tplay/ascii-webcam. On OpenBSD
# the webcam is video(4)/uvideo(4), which ffmpeg's v4l2 input supports, and mpv
# renders video in the terminal on its own (--vo=tct, Unicode half blocks; --vo=caca
# for pure ASCII when mpv was built with libcaca). No OpenCV, no bindgen.
do_run doas pkg_add -I ffmpeg mpv yt-dlp || exit 1

# --- webcam access (OpenBSD FAQ 13) ---
# Video capture is off by default (privacy), and /dev/video0 is root-only.
# Ownership of the device node persists across reboots.
do_run doas sysctl kern.video.record=1
if ! grep -q '^kern.video.record=1' /etc/sysctl.conf 2>/dev/null; then
    log "Persisting kern.video.record=1 in /etc/sysctl.conf"
    if [ "$dry_run" = "0" ]; then echo 'kern.video.record=1' | doas tee -a /etc/sysctl.conf >/dev/null; fi
fi
if [ -c /dev/video0 ]; then
    do_run doas chown "$(id -un)" /dev/video0
else
    log "WARN: no /dev/video0 (no uvideo(4) camera attached?), the wrapper will not find a camera"
fi

# --- asciicam wrapper ---
# asciicam            -> webcam in the terminal
# asciicam FILE|URL   -> any video (or a yt-dlp URL) in the terminal, like tplay
# ASCIICAM_VO=caca asciicam  -> pure ASCII instead of half blocks
bin_dir="$HOME/.local/bin"
do_run mkdir -p "$bin_dir"
log "Writing $bin_dir/asciicam"
if [ "$dry_run" = "0" ]; then
    cat > "$bin_dir/asciicam" <<'WRAP'
#!/bin/sh
# ascii webcam / terminal video player for OpenBSD (generated by runs/openbsd/asciicam)
vo="${ASCIICAM_VO:-tct}"
dev="${ASCIICAM_DEVICE:-/dev/video0}"
if [ $# -gt 0 ]; then
    exec mpv --vo="$vo" --really-quiet "$@"
fi
[ -r "$dev" ] || { echo "asciicam: cannot read $dev (run ./run asciicam, or: doas chown $(id -un) $dev)" >&2; exit 1; }
[ "$(sysctl -n kern.video.record)" = 1 ] || { echo "asciicam: kern.video.record is 0 (doas sysctl kern.video.record=1)" >&2; exit 1; }
# mpv can open the camera itself when built with libavdevice; otherwise ffmpeg
# captures from video(4) and pipes raw frames into mpv.
if mpv --list-protocols 2>/dev/null | grep -q '^ *av://'; then
    exec mpv --vo="$vo" --really-quiet --profile=low-latency --untimed "av://v4l2:$dev"
fi
exec sh -c 'ffmpeg -loglevel error -f v4l2 -i "$1" -c:v rawvideo -f nut - | mpv --vo="$2" --really-quiet --profile=low-latency --untimed -' _ "$dev" "$vo"
WRAP
    chmod 755 "$bin_dir/asciicam"
fi

# --- optional: the Rust tools the Linux branches use (opt-in, slow, may fail) ---
# The opencv crate needs the opencv package plus libclang from llvm%21 (installed
# under /usr/local/llvm21, hence LIBCLANG_PATH). Skipped unless ASCIICAM_CARGO=1.
if [ "${ASCIICAM_CARGO:-0}" = "1" ]; then
    do_run doas pkg_add -I opencv rust cmake || exit 1
    do_run doas pkg_add -I llvm%21 || exit 1
    LIBCLANG_PATH=/usr/local/llvm21/lib
    export LIBCLANG_PATH
    do_run cargo install tplay || log "WARN: cargo install tplay failed"
    do_run cargo install ascii-webcam || log "WARN: cargo install ascii-webcam failed"
else
    log "Skipping the cargo builds of tplay/ascii-webcam (set ASCIICAM_CARGO=1 to try them)."
fi

log "asciicam installed: run 'asciicam' for the webcam, 'asciicam FILE' for a video."
