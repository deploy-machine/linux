#!/bin/sh
# OpenBSD 7.9 -- ascii webcam / media player
# Tolerates failure on purpose: the cargo crates bind against OpenCV/libclang
# and are best effort on OpenBSD.
set -u

dry_run="0"
if [ "${1:-}" = "--dry" ]; then dry_run="1"; fi

log() {
    if [ "$dry_run" = "1" ]; then echo "[DRY_RUN]: $1"; else echo "$1"; fi
}

do_run() {
    log "+ $*"
    if [ "$dry_run" = "0" ]; then "$@"; fi
}

# OpenBSD packages OpenCV: the from-source build of the other branches is not used.
# rust provides cargo (rustup has no OpenBSD host support). pkgconf is needed by
# the opencv crate's build script; ffmpeg/yt-dlp are runtime deps of tplay.
do_run doas pkg_add -I opencv rust pkgconf cmake ffmpeg yt-dlp || exit 1

# The opencv crate uses bindgen, which needs libclang from the llvm package (not
# in base). 7.9 ships llvm 19/20/21, so the branch must be spelled out or pkg_add
# reports "Ambiguous". The package installs under /usr/local/llvm21, which
# clang-sys does not search on its own, hence LIBCLANG_PATH.
do_run doas pkg_add -I llvm%21 || exit 1
LIBCLANG_PATH=/usr/local/llvm21/lib
export LIBCLANG_PATH

# not applicable on OpenBSD: libasound2-dev (ALSA); audio is sndio(7).

# cargo binaries land in ~/.cargo/bin; they do not JIT, so W^X is not an issue.
do_run cargo install tplay || log "WARN: cargo install tplay failed"
do_run cargo install ascii-webcam || log "WARN: cargo install ascii-webcam failed"
