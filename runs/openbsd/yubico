#!/bin/sh
# OpenBSD 7.9 -- FIDO2 / YubiKey support
set -eu

dry_run="0"
if [ "${1:-}" = "--dry" ]; then dry_run="1"; fi

log() {
    if [ "$dry_run" = "1" ]; then echo "[DRY_RUN]: $1"; else echo "$1"; fi
}

do_run() {
    log "+ $*"
    if [ "$dry_run" = "0" ]; then "$@"; fi
}

# libfido2 (headers included; there is no separate -dev package on OpenBSD)
# yubikey-manager verified packaged in 7.9
do_run doas pkg_add -I libfido2 yubikey-manager

# not applicable on OpenBSD: udev rules. There is no udev; FIDO tokens are
# exposed by the fido(4) driver as /dev/fido/* and access is governed by the
# device node permissions (see fido(4)), no extra rules are installed.
