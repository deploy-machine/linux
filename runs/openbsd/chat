#!/bin/sh
# OpenBSD 7.9 -- chat clients
# Tolerates failure on purpose in the best-effort block below.
set -u

dry_run="0"
if [ "${1:-}" = "--dry" ]; then dry_run="1"; fi

log() {
    if [ "$dry_run" = "1" ]; then echo "[DRY_RUN]: $1"; else echo "$1"; fi
}

do_run() {
    log "+ $*"
    if [ "$dry_run" = "0" ]; then "$@"; fi
}

# Install chat clients
do_run doas pkg_add -I irssi || exit 1

# --- PingMe --- not packaged, and its install.sh only fetches prebuilt Linux/macOS
# binaries. It is a Go program, so build it with the go package (runs/openbsd/dev).
# GOBIN puts it in ~/.local/bin, which is on the PATH (~/go/bin is not).
if command -v go >/dev/null 2>&1; then
    do_run env GOBIN="$HOME/.local/bin" go install github.com/kha7iq/pingme@latest || log "WARN: go install pingme failed"
else
    log "WARN: go not found (run ./run dev first), pingme not installed"
fi

# not applicable on OpenBSD: the Tuta desktop client is an Electron build for
# Linux/macOS/Windows only and is not packaged. Use https://app.tuta.com.
log "tuta: no OpenBSD desktop client, use https://app.tuta.com in the browser."
# not applicable on OpenBSD: Discord is Electron, Linux/macOS/Windows only, no package.
log "discord: no OpenBSD client, use https://discord.com/app in chromium or firefox."
