#!/bin/sh
# OpenBSD 7.9 -- chat clients
# Tolerates failure on purpose in the best-effort block below.
set -u

dry_run="0"
if [ "${1:-}" = "--dry" ]; then dry_run="1"; fi

log() {
    if [ "$dry_run" = "1" ]; then echo "[DRY_RUN]: $1"; else echo "$1"; fi
}

do_run() {
    log "+ $*"
    if [ "$dry_run" = "0" ]; then "$@"; fi
}

# Install chat clients (curl is needed for the pingme installer)
do_run doas pkg_add -I irssi curl || exit 1

# --- best effort: PingMe is not packaged; its installer downloads a Go binary
# and may not ship an OpenBSD build ---
if [ "$dry_run" = "0" ]; then
    curl -s https://raw.githubusercontent.com/kha7iq/pingme/master/install.sh | doas sh || log "WARN: pingme installer failed (no OpenBSD build?)"
else
    log "+ curl -s https://raw.githubusercontent.com/kha7iq/pingme/master/install.sh | doas sh"
fi

# not applicable on OpenBSD: the Tuta desktop client is an Electron build for
# Linux/macOS/Windows only and is not packaged. Use https://app.tuta.com.
log "tuta: no OpenBSD desktop client, use https://app.tuta.com in the browser."
