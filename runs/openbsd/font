#!/bin/sh
# OpenBSD 7.9 -- nerd fonts
# Tolerates failure on purpose: one bad font download must not abort the rest.
set -u

dry_run="0"
if [ "${1:-}" = "--dry" ]; then dry_run="1"; fi

log() {
    if [ "$dry_run" = "1" ]; then echo "[DRY_RUN]: $1"; else echo "$1"; fi
}

do_run() {
    log "+ $*"
    if [ "$dry_run" = "0" ]; then "$@"; fi
}

# fontconfig (fc-cache) and mkfontscale are part of base Xenocara; only unzip
# is a package. Downloads use ftp(1) from base instead of wget.
do_run doas pkg_add -I unzip || exit 1

version='2.1.0'
fonts_dir="$HOME/.local/share/fonts"

do_run mkdir -p "$fonts_dir"

fonts="BitstreamVeraSansMono CodeNewRoman DroidSansMono FiraCode FiraMono Go-Mono Hack Hermit JetBrainsMono Meslo Noto Overpass ProggyClean RobotoMono SourceCodePro SpaceMono Ubuntu UbuntuMono"

for font in $fonts; do
    zip_file="$fonts_dir/${font}.zip"
    download_url="https://github.com/ryanoasis/nerd-fonts/releases/download/v${version}/${font}.zip"

    # A zip that fails unzip -t is a truncated or failed download (ftp(1) leaves
    # partial files behind): throw it away and fetch again instead of skipping it.
    if [ -f "$zip_file" ] && ! unzip -tqq "$zip_file" >/dev/null 2>&1; then
        log "$zip_file is not a valid zip, downloading again"
        do_run rm -f "$zip_file"
    fi

    if [ -f "$zip_file" ]; then
        log "$zip_file already downloaded, skipping."
    else
        do_run ftp -o "$zip_file" "$download_url" || { log "WARN: download failed for $font"; rm -f "$zip_file"; continue; }
    fi

    # -n never overwrites, which keeps re-runs idempotent. Errors are shown, not hidden.
    do_run unzip -n -q "$zip_file" -d "$fonts_dir" || log "WARN: unzip failed for $font ($(unzip -tqq "$zip_file" 2>&1 | head -1))"
done

# Nothing below helps if not a single font file was extracted.
if [ "$dry_run" = "0" ] && [ -z "$(find "$fonts_dir" -name '*.ttf' -o -name '*.otf' | head -1)" ]; then
    echo "ERROR: no .ttf/.otf files in $fonts_dir, every unzip failed (see the WARN lines above)" >&2
    exit 1
fi

do_run mkfontscale "$fonts_dir"
do_run mkfontdir "$fonts_dir"
do_run fc-cache -f
