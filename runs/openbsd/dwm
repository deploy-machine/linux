#!/bin/sh
# OpenBSD 7.9 -- dwm, st, rofi and the xenodm session
set -eu

dry_run="0"
if [ "${1:-}" = "--dry" ]; then dry_run="1"; fi

log() {
    if [ "$dry_run" = "1" ]; then echo "[DRY_RUN]: $1"; else echo "$1"; fi
}

do_run() {
    log "+ $*"
    if [ "$dry_run" = "0" ]; then "$@"; fi
}

DEV_ENV_HOME="${DEV_ENV_HOME:-$(cd "$(dirname "$0")/../.." && pwd)}"

# --- Dependencies ---
# X11 is Xenocara in base (/usr/X11R6): libX11, libXft, libXinerama, libXrender,
# freetype, fontconfig, xterm and xrdb need no package. Never install an xorg package.
# harfbuzz + gd: st (hb.c / x.c); imlib2: dwm (drw.c); dash: scripts/bar.sh;
# dbus: scripts/start-dwm.sh (dbus-launch). build-essential/libwebkit2gtk are not needed to build dwm/st.
do_run doas pkg_add -I rofi harfbuzz gd imlib2 dash dbus

# systemd-free: start-dwm.sh talks to the system bus, so enable messagebus via rcctl(8)
do_run doas rcctl enable messagebus
do_run doas rcctl start messagebus

# Get CPU core count
num_cores=$(sysctl -n hw.ncpu)

# --- dwm ---
# Suckless Makefiles build with base BSD make. config.mk defaults are for Linux:
# override the paths on the command line instead of editing the file.
# Packages live under /usr/local, which OpenBSD's cc/ld do NOT search by default,
# so Imlib2.h and -lImlib2 need explicit -I/usr/local/include and -L/usr/local/lib.
# freetype headers are Xenocara's: /usr/X11R6/include/freetype2 (Linux: /usr/include/freetype2).
dwm_incs="-I/usr/X11R6/include -I/usr/X11R6/include/freetype2 -I/usr/local/include"
dwm_libs="-L/usr/X11R6/lib -L/usr/local/lib -lX11 -lXinerama -lfontconfig -lXft -lXrender -lImlib2"
if [ "$dry_run" = "0" ]; then cd "$DEV_ENV_HOME/dwm"; fi
log "Building dwm in $DEV_ENV_HOME/dwm"
# The tree may contain objects/binaries built on Linux (they used to be committed);
# make would treat them as up to date and link or install a Linux ELF that OpenBSD
# cannot run. Do NOT use `make clean` here: dwm's clean target deletes the tracked config.h.
do_run rm -f dwm drw.o dwm.o util.o
do_run make -j"$num_cores" INCS="$dwm_incs" LIBS="$dwm_libs" MANPREFIX=/usr/local/man
do_run doas make install INCS="$dwm_incs" LIBS="$dwm_libs" MANPREFIX=/usr/local/man

# --- st ---
# st's config.mk links -lrt (a Linux libc split; those symbols are in OpenBSD libc),
# so LIBS is overridden without it. The pkg-config backticks are expanded by make.
# -D_BSD_SOURCE is what upstream st's config.mk prescribes for OpenBSD (config.mk
# hardcodes -D_XOPEN_SOURCE=600, which hides the BSD pty/termios bits on its own).
# shellcheck disable=SC2016 # backticks are meant for make(1), not the shell
st_libs='-L/usr/X11R6/lib -L/usr/local/lib -lm -lX11 -lutil -lXft -lgd `pkg-config --libs glib-2.0 fontconfig freetype2 harfbuzz`'
if [ "$dry_run" = "0" ]; then cd "$DEV_ENV_HOME/st"; fi
log "Building st in $DEV_ENV_HOME/st"
# st's clean target keeps config.h (generated from config.def.h), so it is safe here.
do_run make clean
do_run make -j"$num_cores" CPPFLAGS=-D_BSD_SOURCE LIBS="$st_libs" MANPREFIX=/usr/local/man
do_run doas make install CPPFLAGS=-D_BSD_SOURCE LIBS="$st_libs" MANPREFIX=/usr/local/man

# --- Sanity check: the installed binaries must be native OpenBSD executables ---
# `-v` prints the version (to stderr) without needing a display, but both exit 1
# by design, so the output is checked rather than the exit status. A leftover
# Linux ELF ("Exec format error") or a failed build fails here instead of at the
# xenodm login screen.
if [ "$dry_run" = "0" ]; then
    /usr/local/bin/dwm -v 2>&1 | grep -q '^dwm-' || { echo "ERROR: /usr/local/bin/dwm does not run" >&2; exit 1; }
    /usr/local/bin/st -v 2>&1 | grep -q 'st [0-9]' || { echo "ERROR: /usr/local/bin/st does not run" >&2; exit 1; }
fi

# --- Rofi theme and dwm scripts (user-owned copies, no doas) ---
do_run mkdir -p "$HOME/.config/rofi" "$HOME/.config/scripts"
do_run cp -R "$DEV_ENV_HOME/rofi/." "$HOME/.config/rofi/"
do_run cp -R "$DEV_ENV_HOME/scripts/." "$HOME/.config/scripts/"

# --- Session ---
# not applicable on OpenBSD: /usr/share/xsessions/dwm.desktop (gdm). The display
# manager is xenodm(1), which executes ~/.xsession. It is routed through the same
# scripts/start-dwm.sh the Linux session uses (sources ~/.xprofile, exec dwm).
do_run doas cp "$DEV_ENV_HOME/scripts/start-dwm.sh" /usr/local/bin/start-dwm.sh
do_run doas chmod 755 /usr/local/bin/start-dwm.sh

# xenodm does not read ~/.profile: its PATH is DisplayManager*userPath from
# /etc/X11/xenodm/xenodm-config (/usr/local/bin is in it, ~/.local/bin is not).
# ./dev installs tmux-sessionizer, askpass-rofi and cht into ~/.local/bin.
xsession="$HOME/.xsession"
log "Writing $xsession (exec /usr/local/bin/start-dwm.sh)"
if [ "$dry_run" = "0" ]; then
    printf '%s\n' \
        '#!/bin/sh' \
        '# Generated by runs/openbsd/dwm: xenodm runs this file for the X session.' \
        '# Errors end up in ~/.xsession-errors.' \
        'export PATH="$HOME/.local/bin:$PATH"' \
        '# OpenBSD starts sessions in the C locale; without UTF-8 tmux prints _ for every' \
        '# icon and neovim does the same. UTF-8 is the only encoding OpenBSD supports.' \
        'export LANG=en_US.UTF-8 LC_CTYPE=en_US.UTF-8' \
        'exec /usr/local/bin/start-dwm.sh' > "$xsession"
    chmod 755 "$xsession"
fi

# xenodm's Xsetup_0 starts a root-owned xconsole for the login screen, and it
# survives into the session as a "console log" window the user cannot kill.
# Messages still go to /var/log/messages.
if grep -q '^xconsole' /etc/X11/xenodm/Xsetup_0 2>/dev/null; then
    do_run doas sed -i 's/^xconsole/#xconsole/' /etc/X11/xenodm/Xsetup_0
fi

# xenodm is the login screen. `rcctl enable` is idempotent; it is not started here
# because that would launch X on top of the terminal this script runs in.
do_run doas rcctl enable xenodm

log "dwm/st/rofi installed. Log out of xenodm and back in (or: doas rcctl start xenodm) to get the dwm session."
