#!/bin/sh
# OpenBSD 7.9 -- common libraries and cli tools
# Tolerates failure on purpose in the best-effort block below.
set -u

dry_run="0"
if [ "${1:-}" = "--dry" ]; then dry_run="1"; fi

log() {
    if [ "$dry_run" = "1" ]; then echo "[DRY_RUN]: $1"; else echo "$1"; fi
}

do_run() {
    log "+ $*"
    if [ "$dry_run" = "0" ]; then "$@"; fi
}

# No `apt update` equivalent: pkg_add reads the mirror from /etc/installurl.
# g++ / build-essential: clang and make are in base, nothing to install.
# apt-transport-https, ca-certificates, software-properties-common: not applicable on OpenBSD
# (the CA bundle is in base at /etc/ssl/cert.pem).
# bash is needed by scripts/fetch and scripts/cht.sh (they are bash scripts);
# it installs to /usr/local/bin/bash, never /bin/bash.
# rust: for the cargo fallback below.
do_run doas pkg_add -I bash rust scrot bat zip unzip-- curl wget git ripgrep xclip jq shellcheck mpv ffmpeg brotli p7zip meson ninja py3-pip || exit 1

# not applicable on OpenBSD: pulseaudio-utils / pulsemixer. Audio is sndio(7) in
# base and every app here talks to it directly; volume is `sndioctl output.level=+0.1`.
# The pulseaudio package is only a compatibility daemon and is not installed.

# --- best effort: not packaged in 7.9 (checked with pkg_info -Q) ---
# tldr: tealdeer is the rust client (installs the `tldr` command); neither tldr
# nor tealdeer is packaged, so cargo it is (no JIT, ~/.cargo/bin is fine).
do_run cargo install tealdeer || log "WARN: cargo install tealdeer failed"
# shutter: perl/GTK with dozens of perl deps, not packaged; scrot (above) is used instead.

# not applicable on OpenBSD: `ln -s /usr/bin/batcat ~/.local/bin/bat`,
# the package already installs the binary as /usr/local/bin/bat.
do_run mkdir -p "$HOME/.local/bin"
