#!/bin/sh
# OpenBSD 7.9 -- password manager
# Tolerates failure on purpose: the desktop client is flatpak/Electron only,
# so this is a best-effort attempt at the CLI client (see the warning below).
set -u

dry_run="0"
if [ "${1:-}" = "--dry" ]; then dry_run="1"; fi

log() {
    if [ "$dry_run" = "1" ]; then echo "[DRY_RUN]: $1"; else echo "$1"; fi
}

do_run() {
    log "+ $*"
    if [ "$dry_run" = "0" ]; then "$@"; fi
}

# not applicable on OpenBSD: `flatpak install flathub com.bitwarden.desktop`
# (no flatpak, no Electron desktop client package).
# --- best effort: package name unverified for 7.9 ---
do_run doas pkg_add -I bitwarden-cli || log "WARN: bitwarden-cli not available, use the Bitwarden web vault or browser extension"
