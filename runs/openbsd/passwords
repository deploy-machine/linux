#!/bin/sh
# OpenBSD 7.9 -- password manager
# Tolerates failure on purpose: npm installs are best effort.
set -u

dry_run="0"
if [ "${1:-}" = "--dry" ]; then dry_run="1"; fi

log() {
    if [ "$dry_run" = "1" ]; then echo "[DRY_RUN]: $1"; else echo "$1"; fi
}

do_run() {
    log "+ $*"
    if [ "$dry_run" = "0" ]; then "$@"; fi
}

# not applicable on OpenBSD: `flatpak install flathub com.bitwarden.desktop`.
# The desktop client is an Electron build for Linux/macOS/Windows only and is not
# packaged. Use the browser extension or https://vault.bitwarden.com for the GUI.
#
# The official CLI (`bw`) is plain JavaScript on npm, so it runs on the node
# package (installed by runs/openbsd/dev). Global npm installs go to /usr/local.
if ! command -v npm >/dev/null 2>&1; then
    echo "ERROR: npm not found, run ./run dev first (installs the node package)" >&2
    exit 1
fi
do_run doas npm install -g @bitwarden/cli || log "WARN: npm install @bitwarden/cli failed"

log "bitwarden: 'bw login' then 'bw unlock' to use the CLI; the GUI is the browser extension on OpenBSD."
